<!-- sig-blocks:v1: -->
<!-- signature:{{company.key}}:new -->
{{#if meta.greeting}}<p style="margin:0 0 12px 0;font-family:Calibri, Arial, Helvetica, sans-serif;font-size:11pt;line-height:14.3pt;color:{{@root.meta.colors.text}};font-weight:normal">{{meta.greeting}}</p>{{/if}}
<table cellpadding="0" cellspacing="0" border="0" role="presentation" style="border-collapse:collapse;max-width:500px;font-family:Calibri, Arial, Helvetica, sans-serif;">
  <tr>
    <td style="padding:0 10px 0 0;vertical-align:middle;"><img src="{{meta.logoUrl}}" width="{{meta.logoWidth}}" height="{{meta.logoHeight}}" alt="{{meta.logoAlt}}" style="display:block;border:0;width:{{meta.logoWidth}}px;height:{{meta.logoHeight}}px;"></td>
    <td style="padding:0 0 0 10px;vertical-align:middle;border-left:1px solid {{@root.meta.colors.primary}};">
    <table cellpadding="0" cellspacing="0" border="0" role="presentation" style="border-collapse:collapse;">
      {{#if user.displayName}}<tr><td style="padding:0 0 0px 0;font-family:Calibri, Arial, Helvetica, sans-serif;font-size:12pt;line-height:15.6pt;color:{{@root.meta.colors.name}};font-weight:bold">{{user.displayName}}</td></tr>{{/if}}
      {{#if user.jobTitleLv}}<tr><td style="padding:0 0 0px 0;font-family:Calibri, Arial, Helvetica, sans-serif;font-size:11pt;line-height:14.3pt;color:{{@root.meta.colors.title}};font-weight:normal">{{user.jobTitleLv}}</td></tr>{{/if}}
      {{#if user.jobTitleEn}}<tr><td style="padding:0 0 0px 0;font-family:Calibri, Arial, Helvetica, sans-serif;font-size:10pt;line-height:13pt;color:{{@root.meta.colors.muted}};font-weight:normal">{{user.jobTitleEn}}</td></tr>{{/if}}
      <tr><td style="height:6px;line-height:6px;font-size:1px;">&nbsp;</td></tr>
      {{#if user.mobilePhone}}<tr><td style="padding:0 0 0px 0;font-family:Calibri, Arial, Helvetica, sans-serif;font-size:10pt;line-height:13pt;color:{{@root.meta.colors.text}};font-weight:normal">M: <a href="tel:{{tel user.mobilePhone}}" style="color:{{@root.meta.colors.text}};text-decoration:none;">{{user.mobilePhone}}</a></td></tr>{{/if}}
      {{#if user.officePhone}}<tr><td style="padding:0 0 0px 0;font-family:Calibri, Arial, Helvetica, sans-serif;font-size:10pt;line-height:13pt;color:{{@root.meta.colors.text}};font-weight:normal">T: <a href="tel:{{tel user.officePhone}}" style="color:{{@root.meta.colors.text}};text-decoration:none;">{{user.officePhone}}</a></td></tr>{{/if}}
      {{#if user.email}}<tr><td style="padding:0 0 0px 0;font-family:Calibri, Arial, Helvetica, sans-serif;font-size:10pt;line-height:13pt;color:{{@root.meta.colors.primary}};font-weight:normal"><a href="mailto:{{user.email}}" style="color:{{@root.meta.colors.primary}};text-decoration:none;">{{user.email}}</a></td></tr>{{/if}}
      {{#if meta.websites}}<tr><td style="padding:0 0 0px 0;font-family:Calibri, Arial, Helvetica, sans-serif;font-size:10pt;line-height:13pt;color:{{@root.meta.colors.primary}};font-weight:normal">{{#each meta.websites}}<a href="{{url}}" style="color:{{@root.meta.colors.primary}};text-decoration:none;">{{label}}</a>{{#unless @last}}<br>{{/unless}}{{/each}}</td></tr>{{/if}}
      {{#if meta.footer.companyLine}}<tr><td style="padding:0 0 0px 0;font-family:Calibri, Arial, Helvetica, sans-serif;font-size:10pt;line-height:13pt;color:{{@root.meta.colors.text}};font-weight:normal">{{meta.footer.companyLine}}</td></tr>{{/if}}
      {{#if meta.footer.registrationNumber}}<tr><td style="padding:0 0 0px 0;font-family:Calibri, Arial, Helvetica, sans-serif;font-size:10pt;line-height:13pt;color:{{@root.meta.colors.text}};font-weight:normal">Reģ. nr. {{meta.footer.registrationNumber}}</td></tr>{{/if}}
      {{#if meta.footer.address}}<tr><td style="padding:0 0 0px 0;font-family:Calibri, Arial, Helvetica, sans-serif;font-size:10pt;line-height:13pt;color:{{@root.meta.colors.text}};font-weight:normal">{{meta.footer.address}}</td></tr>{{/if}}
    </table>
    </td>
  </tr>
</table>
<table cellpadding="0" cellspacing="0" border="0" role="presentation" style="border-collapse:collapse;width:100%;max-width:600px;margin-top:10px;">
      {{#if meta.bannerUrl}}<tr><td style="padding:0 0 10px 0;">{{#if meta.banner.link}}<a href="{{meta.banner.link}}" style="text-decoration:none;">{{/if}}<img src="{{meta.bannerUrl}}" width="{{meta.banner.width}}" height="{{meta.banner.height}}" alt="{{meta.banner.alt}}" style="display:block;border:0;width:{{meta.banner.width}}px;max-width:100%;height:auto;">{{#if meta.banner.link}}</a>{{/if}}</td></tr>{{/if}}
      {{#if meta.footer.confidential}}<tr><td style="padding:0 0 0px 0;text-align:justify;font-family:Calibri, Arial, Helvetica, sans-serif;font-size:7pt;line-height:9.1pt;color:{{@root.meta.colors.muted}};font-weight:normal;font-style:italic">{{meta.footer.confidential}}</td></tr>{{/if}}
</table>
