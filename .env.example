# Copy to .env and adjust. Everything else (tenant, app ID, certificate, groups) is entered in the
# setup wizard at first launch and stored encrypted in the data volume. Never commit .env.

# Public HTTPS address of the service. Only used to pre-fill the wizard.
PUBLIC_URL=https://sig.tenax.lv

# Port on the Docker host, and which interface it listens on. 127.0.0.1 (default) = only this host, which is
# what a tunnel/reverse proxy on the same host needs. Use 0.0.0.0 only to reach it from other machines.
HOST_PORT=8085
HOST_BIND=127.0.0.1

# Encrypts stored credentials and signs sessions. STRONGLY recommended in production: generate once with
#   openssl rand -base64 32
# and keep a copy outside the server (password manager). If empty, a key is generated into the data volume
# (/data/app.key), right next to the database it protects, so a copy of the volume can decrypt it.
APP_SECRET=

# Optional fixed first-launch setup code (min. 16 letters/digits). If empty, a random one is printed to the log.
SETUP_TOKEN=

# Set to true when a proxy terminates TLS in front of the container (Cloudflare Tunnel, Caddy, nginx, LB).
# Needed so the app sees https (secure cookies) and the real client IP for rate limiting. Only the proxy hop on
# loopback/private networks is trusted, so clients can't spoof their IP with X-Forwarded-For. For a proxy on a
# public address, give its address/CIDR instead of true, e.g. TRUST_PROXY=203.0.113.10
TRUST_PROXY=false

# Cloudflare Zero Trust tunnel token (only for `docker compose --profile tunnel`).
TUNNEL_TOKEN=

# Force the demo directory (fixtures/users.json) regardless of the wizard. The X-Mock-User header is
# never enabled in this image because it runs with NODE_ENV=production.
MOCK_GRAPH=false

LOG_LEVEL=info

# Only for the optional `tls` profile (Caddy with automatic Let's Encrypt certificates).
TLS_HOST=sig.tenax.lv
