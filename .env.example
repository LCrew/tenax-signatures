# Copy to .env and adjust. Everything else (tenant, app ID, certificate, groups) is entered in the
# setup wizard at first launch and stored encrypted in the data volume. Never commit .env.

# Public HTTPS address of the service. Only used to pre-fill the wizard.
PUBLIC_URL=https://sig.tenaxgrupa.lv

# Port on the Docker host.
HOST_PORT=8085

# Encrypts stored credentials and signs sessions. Generate once: openssl rand -base64 32
# If empty, a key is generated into the data volume (/data/app.key). Losing it means re-entering the
# Entra credential in Settings.
APP_SECRET=

# Optional fixed first-launch setup code. If empty, a random one is printed to the log.
SETUP_TOKEN=

# Set to true when a reverse proxy (Caddy, nginx, load balancer) terminates TLS in front of the container.
TRUST_PROXY=false

# Force the demo directory (fixtures/users.json) regardless of the wizard. The X-Mock-User header is
# never enabled in this image because it runs with NODE_ENV=production.
MOCK_GRAPH=false

LOG_LEVEL=info

# Only for the optional `tls` profile (Caddy with automatic Let's Encrypt certificates).
TLS_HOST=sig.tenaxgrupa.lv
